# LeGuard-AI local development environment
# Copy this file to .env.local and replace the placeholder values.
# Never commit real credentials.

# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
# For Docker Compose, the host is usually localhost and the port is 5432.
DATABASE_URL=postgresql://leguard:leguard@localhost:5432/leguard

# Authentication
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Required in production.
JWT_SECRET=replace-with-at-least-32-random-characters

# File storage
# Relative paths are resolved from the project root.
UPLOAD_DIR=.uploads

# AI provider (choose one; AI_PROVIDER is optional and auto-detects)
# Supported values: openrouter, gemini, openai, claude, ollama
# AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-3-5-sonnet-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Email (optional in development; required for password-reset delivery)
RESEND_API_KEY=
EMAIL_FROM=LeGuard-AI <noreply@example.com>

# Monitoring / CI (optional)
# METRICS_TOKEN=replace-with-a-long-random-value
